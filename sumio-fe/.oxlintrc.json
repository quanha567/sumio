{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "jsx-a11y", "typescript", "unicorn", "oxc", "import"],
  "jsPlugins": ["@stylistic/eslint-plugin"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "pedantic": "warn",
    "perf": "warn"
  },
  "rules": {
    "@stylistic/padding-line-between-statements": [
      "error",
      { "blankLine": "always", "prev": "directive", "next": "*" },
      { "blankLine": "any", "prev": "directive", "next": "directive" },
      { "blankLine": "always", "prev": "import", "next": "*" },
      { "blankLine": "any", "prev": "import", "next": "import" },
      { "blankLine": "always", "prev": "*", "next": "return" },
      {
        "blankLine": "always",
        "prev": "*",
        "next": ["multiline-block-like", "multiline-expression", "multiline-const", "multiline-let"]
      },
      {
        "blankLine": "always",
        "prev": [
          "multiline-block-like",
          "multiline-expression",
          "multiline-const",
          "multiline-let"
        ],
        "next": "*"
      },
      { "blankLine": "always", "prev": ["const", "let", "var"], "next": "*" },
      { "blankLine": "any", "prev": ["const", "let", "var"], "next": ["const", "let", "var"] },
      {
        "blankLine": "always",
        "prev": "*",
        "next": ["function", "class", "export", "interface", "type"]
      },
      {
        "blankLine": "always",
        "prev": ["function", "class", "export", "interface", "type"],
        "next": "*"
      },
      { "blankLine": "any", "prev": "export", "next": "export" },
      { "blankLine": "any", "prev": ["interface", "type"], "next": ["interface", "type"] }
    ],
    "@stylistic/lines-between-class-members": [
      "error",
      "always",
      { "exceptAfterSingleLine": true, "exceptAfterOverload": true }
    ],
    "import/newline-after-import": "error",
    "import/no-unassigned-import": "off",
    "no-unused-vars": "error",
    "no-console": ["error", { "allow": ["warn", "error"] }],
    "no-nested-ternary": "error",
    "prefer-const": "error",
    "max-params": ["error", { "max": 3 }],
    "no-else-return": ["error", { "allowElseIf": false }],
    "react/jsx-handler-names": [
      "error",
      {
        "eventHandlerPrefix": "handle",
        "eventHandlerPropPrefix": "on",
        "checkLocalVariables": false,
        "checkInlineFunction": false
      }
    ],
    "react/react-in-jsx-scope": "off",
    "react/jsx-key": "error",
    "react/jsx-no-target-blank": "error",
    "react/jsx-pascal-case": ["error", { "allowAllCaps": true }],
    "react/jsx-boolean-value": ["error", "never"],
    "react/jsx-curly-brace-presence": ["error", { "props": "never", "children": "never" }],
    "react/jsx-no-useless-fragment": "error",
    "react/function-component-definition": ["error", { "namedComponents": "function-declaration" }],
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "warn",
    "react/no-array-index-key": "error",
    "react/incompatible-library": "off",
    "react/set-state-in-effect": "warn",
    "jsx-a11y/label-has-associated-control": "off",
    "jsx-a11y/prefer-tag-over-role": "off",
    "typescript/no-explicit-any": "error",
    "typescript/consistent-type-imports": "error",
    "unicorn/prefer-node-protocol": "error",
    "unicorn/prefer-top-level-await": "off",
    "unicorn/filename-case": ["error", { "case": "kebabCase" }],
    "unicorn/catch-error-name": ["error", { "name": "error" }],
    "no-var": "error",
    "func-name-matching": "error",
    "eqeqeq": "error",
    "no-param-reassign": "error",
    "no-unneeded-ternary": "error",
    "prefer-template": "error",
    "no-template-curly-in-string": "error",
    "yoda": "error",
    "no-self-compare": "error",
    "no-duplicate-imports": "off",
    "max-lines": ["error", { "max": 350, "skipBlankLines": true, "skipComments": true }],
    "max-lines-per-function": [
      "warn",
      { "max": 100, "skipBlankLines": true, "skipComments": true }
    ],
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "@heroui/react",
            "message": "Direct import from @heroui/react is forbidden. Import from '@/components/atoms' instead."
          },
          {
            "name": "@heroui/styles",
            "message": "Direct import from @heroui/styles is forbidden outside components/atoms/."
          },
          {
            "name": "recharts",
            "message": "Direct import from recharts is forbidden. Import chart components from '@/components/molecules' instead."
          },
          {
            "name": "motion/react",
            "message": "Direct import from motion/react is forbidden in features. Use wrappers from '@/components/motion' instead."
          }
        ]
      }
    ]
  },
  "env": {
    "browser": true,
    "es2024": true,
    "node": true
  },
  "overrides": [
    {
      "files": ["src/components/atoms/**"],
      "rules": {
        "no-restricted-imports": "off"
      }
    },
    {
      "files": ["src/components/molecules/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@heroui/react",
                "message": "Direct import from @heroui/react is forbidden. Import from '@/components/atoms' instead."
              },
              {
                "name": "@heroui/styles",
                "message": "Direct import from @heroui/styles is forbidden outside components/atoms/."
              },
              {
                "name": "motion/react",
                "message": "Direct import from motion/react is forbidden in features. Use wrappers from '@/components/motion' instead."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/components/motion/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@heroui/react",
                "message": "Direct import from @heroui/react is forbidden. Import from '@/components/atoms' instead."
              },
              {
                "name": "@heroui/styles",
                "message": "Direct import from @heroui/styles is forbidden outside components/atoms/."
              },
              {
                "name": "recharts",
                "message": "Direct import from recharts is forbidden. Import chart components from '@/components/molecules' instead."
              }
            ]
          }
        ]
      }
    }
  ],
  "ignorePatterns": ["dist/**", "node_modules/**", "src/routeTree.gen.ts"]
}
