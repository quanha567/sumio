# ==========================================
# Sumio Backend Environment Variables (.env)
# Used by: bun run start:dev & Docker
# ==========================================

# ------------------------------------------
# Database Configuration (PostgreSQL / Supabase)
# ------------------------------------------
# Local development default:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sumio
DATABASE_SSL=false

# Remote Supabase (Transaction Pooler port 6543 / Session Pooler port 5432):
# DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# DATABASE_SSL=true

# ------------------------------------------
# Firebase Authentication
# ------------------------------------------
# Project ID used by jose to verify Google JWKS token signature (iss & aud)
FIREBASE_PROJECT_ID=sumio-app

# ------------------------------------------
# Server Configuration
# ------------------------------------------
PORT=3000
NODE_ENV=development

# Comma-separated allowed origins for CORS
CORS_ORIGINS=http://localhost:5173,https://sumio-dev.pages.dev,https://sumio.pages.dev
